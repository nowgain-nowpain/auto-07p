#!/bin/sh
echo "AUTO: the @-command scripts are deprecated and will be removed; use the 'auto' CLI or the Python commands (run, load, save, ...)." 1>&2
# copy one level deep without hidden files
for i in "$AUTO_DIR"/demos/$1/*
do
  if test -d "$i"; then
    d=`expr "$i" : "$AUTO_DIR/demos/$1/\(.*\)"`
    if test -f "$d"; then
      rm "$d$"
    fi
    mkdir -p $d > /dev/null 2>&1
    cp "$i"/* $d
  else
    cp "$i" .
  fi
done
echo "Copying demo $1 ... done"
